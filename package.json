{
  "name": "hale",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~56.0.13",
    "expo-apple-authentication": "~56.0.4",
    "expo-audio": "~56.0.12",
    "expo-auth-session": "~56.0.14",
    "expo-dev-client": "~56.0.21",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.2",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "replay": "tsx scripts/replay.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "audio": "tsx scripts/generate-audio.ts",
    "verify:audio": "tsx scripts/verify-audio.ts",
    "verify:pose-models": "bash scripts/verify-pose-models.sh",
    "verify:safe-beta-flags": "env EAS_BUILD_PROFILE=beta EXPO_PUBLIC_ENABLE_LEGACY_V1_CHECKUP_ROLLBACK=0 EXPO_PUBLIC_ENABLE_MOVEMENT_PROFILE_V2_INTERNAL=0 EXPO_PUBLIC_ENABLE_MOVEMENT_PROFILE_V2_DIAGNOSTICS=0 EXPO_PUBLIC_ENABLE_POSE_LATENCY_DIAGNOSTICS=0 EXPO_PUBLIC_ALLOW_DIAGNOSTICS_IN_RELEASE=0 EXPO_PUBLIC_ENABLE_POSE_RENDERER_BENCHMARKS=0 npx expo config --type public",
    "eas-build-pre-install": "bash scripts/download-models.sh && bash scripts/verify-pose-models.sh",
    "build:android:beta": "bash scripts/download-models.sh && npm run verify:pose-models && npx eas-cli@latest build -p android --profile beta",
    "noise-floor": "tsx scripts/noise-floor.ts",
    "skeleton-preview": "tsx scripts/skeleton-preview.ts",
    "pose-renderer-replay": "tsx scripts/pose-renderer-replay.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/modules"
    ]
  },
  "private": true
}
