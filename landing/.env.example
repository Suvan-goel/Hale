# ── Lead backend — configure exactly one ────────────────────────────────────
# Default: the repo's Supabase project. Run the landing_leads migration
# (supabase/migrations/20260722000100_landing_leads.sql), then set:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternative: any endpoint accepting the JSON lead payload as a POST.
# Takes precedence over Supabase when set.
VITE_LEAD_ENDPOINT=

# ── Meta ads ─────────────────────────────────────────────────────────────────
# Pixel ID, digits only. Unset = the pixel never loads.
VITE_META_PIXEL_ID=

# Canonical production origin, no trailing slash (e.g. https://www.example.com).
# Emits absolute og:image/og:url/canonical tags at build time; without it the
# Facebook share card will not render.
VITE_SITE_URL=

# ── Contact ──────────────────────────────────────────────────────────────────
VITE_CONTACT_EMAIL=suvangoel@gmail.com
