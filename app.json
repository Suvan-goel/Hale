{
  "expo": {
    "name": "Hale",
    "slug": "hale",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/ios-icon.png",
    "plugins": [
      "./modules/expo-pose-detection/app.plugin.js",
      "expo-audio",
      "expo-font"
    ],
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F2EA",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/ios-icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera measures your movement as a skeleton outline. Camera video is never shown or stored."
      },
      "bundleIdentifier": "com.suvangoel.hale"
    },
    "android": {
      "icon": "./assets/android-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#F7F2EA",
        "foregroundImage": "./assets/android-icon.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.suvangoel.hale"
    }
  }
}
