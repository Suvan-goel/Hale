# Copy to .env and fill in. Only EXPO_PUBLIC_* vars are exposed to the app
# bundle; the rest are build-time only. See docs/auth-supabase-setup.md for the
# Supabase dashboard steps the OAuth/Apple values below depend on.

# --- Supabase backend (optional sign-in: non-health online profile only) ---
# The app's deep-link scheme is `pearl` and the iOS/Android bundle id is
# `com.suvangoel.pearl`. In the Supabase dashboard you must:
#   1. Auth > URL Configuration > Redirect URLs: add `pearl://auth/callback`
#      (used by Google sign-in and password-reset emails).
#   2. Auth > Providers > Apple > Authorized Client IDs: add
#      `com.suvangoel.pearl` (native Apple sign-in validates this audience).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Enable only after the profile migration, deletion function, redirect URLs,
# production email delivery, and reviewed privacy/deletion URLs are live.
EXPO_PUBLIC_ENABLE_ONLINE_PROFILES=0
# Release builds reject this flag until the native flow has approved
# cryptographic nonce/state replay protection and real-device tests.
EXPO_PUBLIC_ENABLE_APPLE_SIGN_IN=0
# Required for release builds that expose account creation. The link appears
# beside the sign-up disclosure in Settings.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.example/privacy

# --- Error reporting (Sentry) ---
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENABLE_SENTRY=0

# --- Build-time only: voice-line generation (never used at runtime) ---
# Required to run `npm run audio` (synthesizes bundled voice lines via the
# ElevenLabs API). Never committed; not read by the app at runtime.
ELEVENLABS_API_KEY=

# --- Diagnostics / dev flags (keep 0 for beta/release builds) ---
EXPO_PUBLIC_ENABLE_MOVEMENT_PROFILE_V2_INTERNAL=0
EXPO_PUBLIC_ENABLE_MOVEMENT_PROFILE_V2_DIAGNOSTICS=0
EXPO_PUBLIC_ENABLE_POSE_LATENCY_DIAGNOSTICS=0
EXPO_PUBLIC_ALLOW_DIAGNOSTICS_IN_RELEASE=0
# The privacy-preserving tinted matte is on by default. Set to 0 only for a
# comparative real-device performance or edge-quality diagnostics pass.
EXPO_PUBLIC_SEGMENTATION_MASK_FIGURE=1
